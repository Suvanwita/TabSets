{
  "manifest_version": 3,
  "name": "TabSets — Named Browser Sessions",
  "short_name": "TabSets",
  "version": "1.0.0",
  "description": "Organize, save, and manage your browser window tab sets as named workspaces.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TabSets Workspaces"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "tabs",
    "storage"
  ]
}
